# Copy to .env.local for development. Set the same names in Vercel for production.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only secret key (sb_secret_...). Never expose to the browser.
SUPABASE_SECRET_KEY=

# Internal email for the single Supabase Auth user (never shown in the UI).
ADMIN_AUTH_EMAIL=

# Random string; Vercel Cron sends it as a Bearer token. Generate: openssl rand -hex 32
CRON_SECRET=

# IANA timezone used for "today" and recurring-transaction dates.
APP_TIME_ZONE=America/Vancouver
